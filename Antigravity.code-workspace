{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		// ## Antigravity ########################################################
		// # Prevent Antigravity from opening files in its proprietary form view #
		// #######################################################################
		//
		// 1. CRITICAL: Force the IDE to use the standard text editor ("default")
		// instead of the proprietary "Antigravity Form View" for these files.
		"workbench.editorAssociations": {
			"**/.agent/rules/**/*.md": "default",
			"**/.agent/skills/**/*.md": "default",
			"**/.agent/tools/**/*.md": "default",
			"**/.agent/workflows/**/*.md": "default"
		},
		// 2. Ensure they are treated as standard Markdown for syntax highlighting
    	// (Do NOT use 'antigravity-markdown' here, as that may re-trigger the GUI)
		"files.associations": {
			"**/.agent/**/*.md": "markdown"
		},
		"terminal.integrated.defaultProfile.windows": "PowerShell 7",
		"terminal.integrated.profiles.windows": {
			"PowerShell 7": {
				"path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
				"args": [
					"-NoLogo"
				]
			}
		},
		"terminal.integrated.env.windows": {
			"PYTHONUTF8": "1",
			"PYTHONIOENCODING": "utf-8"
		},
		"python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
		"python.terminal.activateEnvironment": false
	}
}
