{
    "test_suite": "scoring_matrix_validation",
    "version": "1.0.0",
    "tests": [
        {
            "test_id": "sm_001",
            "name": "NFR wins via numeric metrics",
            "input": "IPC latency MUST be < 1ms for metadata frames and < 20ms for 1MB payloads",
            "expected_scores": {
                "BRD": 3,
                "NFR": 7,
                "FSD": 3,
                "SAD": 1,
                "ICD": 3,
                "TDD": 1,
                "ISP": 0
            },
            "expected_winner": "NFR",
            "expected_confidence": 0.82
        },
        {
            "test_id": "sm_002",
            "name": "Tie-breaker: BRD > NFR",
            "input": "Achieve market leadership through 50% faster response times than competitors",
            "expected_scores": {
                "BRD": 6,
                "NFR": 6,
                "FSD": 2,
                "SAD": 0,
                "ICD": 1,
                "TDD": 0,
                "ISP": 0
            },
            "expected_winner": "BRD",
            "tie_breaker_applied": true,
            "expected_confidence": 0.70
        },
        {
            "test_id": "sm_003",
            "name": "Cross-tier synthesis required",
            "input": "Enable real-time voice interaction (< 500ms latency) using pipeline: wake word → VAD → ASR",
            "expected_scores": {
                "BRD": 8,
                "NFR": 7,
                "FSD": 9,
                "SAD": 0,
                "ICD": 1,
                "TDD": 0,
                "ISP": 0
            },
            "expected_winner": "FSD",
            "decomposition_recommended": true,
            "expected_tags": [
                "BRD-X",
                "NFR-Y",
                "FSD-Z"
            ]
        }
    ]
}
