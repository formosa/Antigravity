{
  "skill_id": "tier_classifier_v1",
  "name": "DDR Tier Classifier",
  "version": "1.0.0",
  "description": "Analyzes unstructured information and assigns it to correct DDR tier (BRD/NFR/FSD/SAD/ICD/TDD/ISP) using decision tree logic and multi-factor scoring",
  "author": "DDR System Migration Team",
  "created": "2026-01-22",
  "category": "documentation",
  "tags": ["ddr", "classification", "requirements", "architecture"],

  "inputs": {
    "fragment": {
      "type": "string",
      "required": true,
      "description": "Unstructured information to classify"
    },
    "context": {
      "type": "object",
      "required": false,
      "description": "Optional project context (existing tags, glossary terms)",
      "properties": {
        "existing_tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "glossary": {
          "type": "object"
        },
        "parent_candidates": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "output_format": {
      "type": "string",
      "enum": ["rst", "json", "report"],
      "default": "rst",
      "description": "Desired output format"
    }
  },

  "outputs": {
    "tier": {
      "type": "string",
      "enum": ["BRD", "NFR", "FSD", "SAD", "ICD", "TDD", "ISP"],
      "description": "Assigned DDR tier"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Classification confidence score"
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "decision_path": {
          "type": "array",
          "description": "Decision tree traversal (Q1-Q6 answers)"
        },
        "scores": {
          "type": "object",
          "description": "Per-tier scoring breakdown if ambiguous"
        },
        "factors_detected": {
          "type": "array",
          "description": "Classification factors present in fragment"
        }
      }
    },
    "parent_citations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Suggested parent tag citations"
    },
    "formatted_output": {
      "type": "string",
      "description": "RST directive or formatted report"
    },
    "validation_warnings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Tier-specific constraint violations"
    }
  },

  "prompts": {
    "system": "prompts/system.md",
    "decision_tree": "prompts/decision_tree.md",
    "scoring_matrix": "prompts/scoring_matrix.md"
  },

  "knowledge_sources": [
    "knowledge/tier_definitions.json",
    "knowledge/classification_factors.json",
    "knowledge/validation_rules.json"
  ],

  "dependencies": {
    "skills": [],
    "models": ["claude-sonnet-4-20250514"],
    "min_context_window": 50000
  },

  "performance": {
    "avg_tokens": 2500,
    "cache_enabled": true,
    "cached_content": ["knowledge/*", "prompts/decision_tree.md"]
  }
}
