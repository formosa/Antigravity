{
    "tier_validation_rules": {
        "BRD": {
            "forbidden_terms": {
                "rule_id": "brd_technology_agnostic",
                "severity": "ERROR",
                "message": "BRD content MUST NOT contain technology-specific terms",
                "patterns": [
                    "\\b(Python|JavaScript|Java|C\\+\\+|Rust|Go|Ruby)\\b",
                    "\\b(ZeroMQ|zmq|Redis|PostgreSQL|MongoDB|MySQL)\\b",
                    "\\b(React|Vue|Angular|Django|Flask|Express)\\b",
                    "\\b(Docker|Kubernetes|AWS|Azure|GCP|Heroku)\\b",
                    "\\b(REST|GraphQL|gRPC|SOAP|WebSocket)\\b",
                    "\\b(JSON|XML|YAML|Protobuf|Avro)\\b",
                    "\\b(CUDA|OpenCL|Vulkan|DirectX)\\b",
                    "\\b(TCP|UDP|HTTP|HTTPS|MQTT|AMQP)\\b"
                ],
                "examples": {
                    "violations": [
                        "Wake word detection using pvporcupine",
                        "Use ZeroMQ for inter-process communication",
                        "Deploy on RTX 3080 GPU"
                    ],
                    "corrections": [
                        "Hands-free voice activation",
                        "Enable reliable message passing between components",
                        "Support GPU-accelerated inference"
                    ]
                }
            },
            "measurable_metrics": {
                "rule_id": "brd_measurable_metrics",
                "severity": "ERROR",
                "message": "Success criteria MUST include measurable, quantifiable metrics",
                "forbidden_patterns": [
                    "\\b(fast|slow|quick|rapid)\\b(?!.*<\\s*\\d+)",
                    "\\b(reliable|stable|robust)\\b(?!.*\\d+%)",
                    "\\b(scalable|flexible|extensible)\\b",
                    "\\b(user-friendly|intuitive|easy)\\b",
                    "\\b(better|improved|enhanced|optimized)\\b(?!.*\\d+)"
                ],
                "required_patterns": [
                    "(<|>|<=|>=)\\s*\\d+",
                    "\\d+\\s*%",
                    "\\d+\\s*(second|ms|minute|hour|day)",
                    "\\d+\\s*(MB|GB|TB|users|transactions)"
                ],
                "examples": {
                    "violations": [
                        "System must be fast",
                        "Provide reliable operation",
                        "Create an intuitive user experience"
                    ],
                    "corrections": [
                        "Response time < 1 second",
                        "99.9% uptime, < 5 second recovery",
                        "< 3 steps to complete core task"
                    ]
                }
            }
        },
        "NFR": {
            "numeric_constraints": {
                "rule_id": "nfr_numeric_constraints",
                "severity": "ERROR",
                "message": "All constraints MUST include specific numeric values with units",
                "required_patterns": [
                    "\\d+\\s*(ms|millisecond|second|minute|hour|day)",
                    "\\d+\\s*(MB|GB|KB|TB|byte)",
                    "\\d+\\s*%",
                    "\\d+\\s*(core|thread|process|instance)",
                    "<\\s*\\d+",
                    ">\\s*\\d+"
                ],
                "forbidden_patterns": [
                    "\\b(low|high|minimal|maximal)\\b.*\\b(latency|throughput|memory|bandwidth)\\b(?!.*\\d+)",
                    "\\b(reasonable|acceptable|sufficient|adequate)\\b",
                    "\\b(fast|slow|quick)\\b(?!.*\\d+)"
                ],
                "examples": {
                    "violations": [
                        "System must have low latency",
                        "Memory usage must be reasonable",
                        "Latency must be under 100"
                    ],
                    "corrections": [
                        "Latency < 1 second",
                        "Memory usage < 4GB RAM",
                        "Latency < 100ms"
                    ]
                }
            }
        },
        "FSD": {
            "no_implementation": {
                "rule_id": "fsd_no_implementation",
                "severity": "ERROR",
                "message": "FSD MUST describe capabilities/behaviors, NOT implementation mechanisms",
                "forbidden_patterns": [
                    "\\bclass\\s+\\w+",
                    "\\bdef\\s+\\w+\\s*\\(",
                    "\\.\\w+\\(\\)",
                    "\\bimport\\s+\\w+",
                    "\\b(pvporcupine|transitions|loguru|zmq)\\b",
                    "Dict\\[\\w+,\\s*\\w+\\]",
                    "\\w+\\.create\\(\\)",
                    "using\\s+\\w+\\.\\w+"
                ],
                "examples": {
                    "violations": [
                        "Use pvporcupine.create() for wake word detection",
                        "Implement using transitions.Machine for state management",
                        "Store active requests in Dict[str, Tuple[bytes, float]]"
                    ],
                    "corrections": [
                        "Detect wake word with < 200ms latency",
                        "Maintain hierarchical state machine",
                        "Track pending requests"
                    ]
                }
            }
        },
        "SAD": {
            "ascii_diagram_required": {
                "rule_id": "sad_ascii_diagram_required",
                "severity": "WARNING",
                "message": "SAD sections SHOULD include ASCII topology diagrams",
                "required_patterns": [
                    "\\+[-]+\\+",
                    "\\|.*\\|",
                    "<[-]+>",
                    "[-]+>"
                ],
                "examples": {
                    "correct": [
                        "+-------+     +-------+\n| Core  |<--->| UI    |\n+-------+     +-------+"
                    ]
                }
            }
        },
        "ICD": {
            "schema_format": {
                "rule_id": "icd_schema_format",
                "severity": "WARNING",
                "message": "ICD schemas SHOULD use proper JSON/YAML syntax with code blocks",
                "required_patterns": [
                    "```(json|yaml)",
                    "\\{\\s*\"\\w+\"",
                    "\\w+:\\s*\\w+"
                ]
            }
        },
        "TDD": {
            "no_logic": {
                "rule_id": "tdd_no_logic",
                "severity": "ERROR",
                "message": "TDD defines structure/wiring, NOT implementation logic",
                "forbidden_patterns": [
                    "\\bif\\s+\\w+:",
                    "\\bfor\\s+\\w+\\s+in",
                    "\\bwhile\\s+\\w+:",
                    "\\btry:\\s*\\n",
                    "\\bexcept\\s+\\w+:",
                    "\\breturn\\s+\\w+\\.",
                    "self\\.\\w+\\s*=\\s*\\w+\\("
                ],
                "examples": {
                    "violations": [
                        "def run(self): while True: msg = self.socket.recv()"
                    ],
                    "corrections": [
                        "Method: run() - Main receive loop"
                    ]
                }
            }
        },
        "ISP": {
            "stub_only": {
                "rule_id": "isp_stub_only",
                "severity": "ERROR",
                "message": "ISP method bodies MUST contain only 'pass' statements",
                "forbidden_patterns": [
                    "\\breturn\\s+(?!None)\\w+",
                    "self\\.\\w+\\s*=",
                    "\\w+\\s*=\\s*\\w+\\(",
                    "\\bif\\s+",
                    "\\bfor\\s+",
                    "\\bwhile\\s+",
                    "\\w+\\.\\w+\\("
                ],
                "required_patterns": [
                    "\\bpass\\s*$"
                ],
                "examples": {
                    "violations": [
                        "def __init__(self, config): self.context = zmq.Context()",
                        "def run(self): while True: self.handle_message()"
                    ],
                    "corrections": [
                        "def __init__(self, config: str):\n    pass",
                        "def run(self) -> None:\n    pass"
                    ]
                }
            },
            "numpy_docstrings": {
                "rule_id": "isp_numpy_docstrings",
                "severity": "ERROR",
                "message": "All ISP methods MUST have Numpy-style docstrings with Implements/Requirements",
                "required_patterns": [
                    "\"\"\"[^\"]+\"\"\"",
                    "Parameters\\s*\\n\\s*[-]+",
                    "Returns\\s*\\n\\s*[-]+",
                    "Implements:\\s*\\|\\w+-\\d+"
                ],
                "forbidden_patterns": [
                    "Args:\\s*\\n",
                    "@param\\s+\\w+",
                    ":param\\s+\\w+:"
                ],
                "examples": {
                    "correct": [
                        "def run(self) -> None:\n    \"\"\"\n    Main event loop.\n\n    Implements: |TDD-1.8|\n    \"\"\"\n    pass"
                    ],
                    "incorrect": [
                        "def run(self):\n    # Main loop\n    pass",
                        "def run(self):\n    \"\"\"Run the loop.\n\n    Args:\n        None\n    \"\"\"\n    pass"
                    ]
                }
            }
        }
    },
    "citation_validation": {
        "valid_citation_matrix": {
            "NFR": [
                "BRD"
            ],
            "FSD": [
                "BRD",
                "NFR"
            ],
            "SAD": [
                "FSD",
                "NFR"
            ],
            "ICD": [
                "SAD",
                "NFR"
            ],
            "TDD": [
                "SAD",
                "ICD"
            ],
            "ISP": [
                "TDD"
            ]
        },
        "citation_required": {
            "exempt_tiers": [
                "BRD"
            ],
            "rule": "All non-BRD tags MUST have at least one parent citation via :links:",
            "severity": "ERROR"
        },
        "sibling_prohibition": {
            "rule": "Tags MUST NOT cite peer tags at same abstraction level",
            "detection_pattern": ":(FSD-\\d+).*:links:.*\\1\\.\\d+",
            "severity": "ERROR"
        }
    }
}
