{
    "factors": [
        {
            "id": "numeric_metrics",
            "name": "Contains Numeric Metrics",
            "description": "Fragment includes specific numbers with units (ms, MB, %, cores, etc.)",
            "detection_patterns": [
                "\\d+\\s*(ms|millisecond|second|minute|hour)",
                "\\d+\\s*(MB|GB|KB|TB)",
                "\\d+\\s*%",
                "\\d+\\s*(core|thread|process)",
                "<\\s*\\d+",
                ">\\s*\\d+"
            ],
            "weights": {
                "BRD": 1,
                "NFR": 3,
                "FSD": 1,
                "SAD": 0,
                "ICD": 2,
                "TDD": 0,
                "ISP": 0
            }
        },
        {
            "id": "hardware_reference",
            "name": "References Hardware",
            "description": "Fragment mentions specific hardware components or specifications",
            "detection_patterns": [
                "\\b(GPU|CPU|RAM|VRAM|memory|processor|core)\\b",
                "\\b(RTX|GeForce|NVIDIA|AMD|Intel)\\b",
                "\\b(CUDA|OpenCL|Vulkan)\\b",
                "\\b(network|bandwidth|ethernet|WiFi)\\b",
                "\\b(disk|SSD|storage)\\b"
            ],
            "weights": {
                "BRD": 1,
                "NFR": 3,
                "FSD": 0,
                "SAD": 1,
                "ICD": 0,
                "TDD": 0,
                "ISP": 0
            }
        },
        {
            "id": "user_behavior",
            "name": "Describes User Behavior",
            "description": "Fragment describes user actions, workflows, or interactions",
            "detection_patterns": [
                "\\b(user|operator|stakeholder)\\b.*\\b(can|may|should|will|must)\\b",
                "\\b(click|press|speak|type|select|choose|activate)\\b",
                "\\b(workflow|interaction|experience|interface)\\b",
                "\\b(receives|provides|enters|submits)\\b.*\\b(feedback|input|response)\\b"
            ],
            "weights": {
                "BRD": 2,
                "NFR": 0,
                "FSD": 3,
                "SAD": 0,
                "ICD": 0,
                "TDD": 0,
                "ISP": 0
            }
        },
        {
            "id": "pattern_naming",
            "name": "Names Architectural Patterns",
            "description": "Fragment explicitly names design or architectural patterns",
            "detection_patterns": [
                "\\b(Hub-and-Spoke|Client-Server|Pub-Sub|Publisher-Subscriber)\\b",
                "\\b(Event-Driven|Message-Driven|Actor Model)\\b",
                "\\b(ROUTER|DEALER|PUSH|PULL|REQ|REP)\\b.*\\b(pattern|topology)\\b",
                "\\b(MVC|MVVM|Singleton|Factory|Observer)\\b",
                "\\b(microservice|monolith|distributed|decoupled)\\b.*\\b(architecture)\\b"
            ],
            "weights": {
                "BRD": 0,
                "NFR": 0,
                "FSD": 0,
                "SAD": 3,
                "ICD": 0,
                "TDD": 1,
                "ISP": 0
            }
        },
        {
            "id": "schema_definition",
            "name": "Defines JSON/YAML Schemas",
            "description": "Fragment contains structured data definitions or schemas",
            "detection_patterns": [
                "\\{\\s*\"\\w+\"\\s*:",
                "\\w+:\\s*\\w+\\s*#.*YAML",
                "\\b(schema|format|structure|contract)\\b.*\\b(JSON|YAML|XML)\\b",
                "\\b(field|property|attribute)\\s+\\w+\\s*:\\s*\\w+",
                "```(json|yaml)"
            ],
            "weights": {
                "BRD": 0,
                "NFR": 0,
                "FSD": 0,
                "SAD": 0,
                "ICD": 3,
                "TDD": 0,
                "ISP": 1
            }
        },
        {
            "id": "class_names",
            "name": "Contains Class/Module Names",
            "description": "Fragment references specific classes, modules, or OOP structures",
            "detection_patterns": [
                "\\b[A-Z][a-z]+([A-Z][a-z]+)+\\b(?!\\s+(pattern|architecture))",
                "\\bclass\\s+\\w+",
                "\\w+Process\\b",
                "\\w+Server\\b",
                "\\w+Manager\\b",
                "\\w+Handler\\b"
            ],
            "weights": {
                "BRD": 0,
                "NFR": 0,
                "FSD": 0,
                "SAD": 0,
                "ICD": 0,
                "TDD": 3,
                "ISP": 2
            }
        },
        {
            "id": "executable_code",
            "name": "Has Executable Code",
            "description": "Fragment contains actual code syntax (Python, etc.)",
            "detection_patterns": [
                "\\bdef\\s+\\w+\\s*\\(",
                "\\bclass\\s+\\w+\\s*[:\\(]",
                "\\bimport\\s+\\w+",
                "\\bfrom\\s+\\w+\\s+import",
                "\\bpass\\s*$",
                "\\breturn\\s+",
                "self\\.\\w+"
            ],
            "weights": {
                "BRD": 0,
                "NFR": 0,
                "FSD": 0,
                "SAD": 0,
                "ICD": 0,
                "TDD": 0,
                "ISP": 3
            }
        },
        {
            "id": "modality_keywords",
            "name": "Uses MUST/SHALL Modality",
            "description": "Fragment uses RFC 2119 requirement keywords",
            "detection_patterns": [
                "\\bMUST\\b",
                "\\bMUST NOT\\b",
                "\\bSHALL\\b",
                "\\bSHALL NOT\\b",
                "\\bSHOULD\\b",
                "\\bSHOULD NOT\\b",
                "\\bMAY\\b",
                "\\bREQUIRED\\b",
                "\\bOPTIONAL\\b"
            ],
            "weights": {
                "BRD": 2,
                "NFR": 3,
                "FSD": 2,
                "SAD": 1,
                "ICD": 1,
                "TDD": 1,
                "ISP": 0
            }
        },
        {
            "id": "rationale_included",
            "name": "Includes Rationale",
            "description": "Fragment explains WHY or provides justification",
            "detection_patterns": [
                "\\b(because|since|to enable|to support|to ensure|to allow)\\b",
                "\\b(justifies|enables|supports|facilitates)\\b",
                "\\b(reason|rationale|purpose|objective)\\b",
                "\\bin order to\\b",
                "\\bso that\\b"
            ],
            "weights": {
                "BRD": 3,
                "NFR": 1,
                "FSD": 1,
                "SAD": 3,
                "ICD": 0,
                "TDD": 2,
                "ISP": 0
            }
        },
        {
            "id": "technology_agnostic",
            "name": "Technology-Agnostic Language",
            "description": "Fragment avoids technology-specific terms",
            "detection_patterns": [
                "(?!.*(Python|JavaScript|Java|C\\+\\+|Rust))",
                "(?!.*(ZeroMQ|Redis|PostgreSQL|MongoDB))",
                "(?!.*(React|Vue|Angular|Django|Flask))",
                "(?!.*(Docker|Kubernetes|AWS|Azure|GCP))",
                "(?!.*(JSON|XML|YAML|Protobuf))",
                "(?!.*(REST|GraphQL|gRPC|SOAP))"
            ],
            "weights": {
                "BRD": 3,
                "NFR": 1,
                "FSD": 2,
                "SAD": 0,
                "ICD": 0,
                "TDD": 0,
                "ISP": 0
            }
        }
    ],
    "scoring_config": {
        "max_possible_score": 30,
        "confidence_formula": "(winner_score / max_possible_score) * semantic_fit_multiplier",
        "semantic_fit_range": [
            0.7,
            1.0
        ],
        "tie_breaker_hierarchy": [
            "BRD",
            "NFR",
            "FSD",
            "SAD",
            "ICD",
            "TDD",
            "ISP"
        ]
    }
}
