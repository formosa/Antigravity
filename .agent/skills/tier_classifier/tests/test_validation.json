{
    "test_suite": "constraint_validation",
    "version": "1.0.0",
    "tests": [
        {
            "test_id": "cv_001",
            "name": "BRD technology violation",
            "tier": "BRD",
            "input": "Use ZeroMQ for inter-process messaging to enable modularity",
            "expected_violations": [
                {
                    "rule_id": "brd_technology_agnostic",
                    "severity": "ERROR",
                    "pattern_matched": "ZeroMQ"
                }
            ]
        },
        {
            "test_id": "cv_002",
            "name": "BRD subjective metric violation",
            "tier": "BRD",
            "input": "System must be fast and reliable for user satisfaction",
            "expected_violations": [
                {
                    "rule_id": "brd_measurable_metrics",
                    "severity": "ERROR",
                    "pattern_matched": "fast.*reliable"
                }
            ]
        },
        {
            "test_id": "cv_003",
            "name": "NFR missing units",
            "tier": "NFR",
            "input": "Response latency must be under 100",
            "expected_violations": [
                {
                    "rule_id": "nfr_numeric_constraints",
                    "severity": "ERROR",
                    "message": "Missing units for numeric value"
                }
            ]
        },
        {
            "test_id": "cv_004",
            "name": "FSD implementation leakage",
            "tier": "FSD",
            "input": "User interrupts via spacebar which calls ui_process.send_cancel() method",
            "expected_violations": [
                {
                    "rule_id": "fsd_no_implementation",
                    "severity": "ERROR",
                    "pattern_matched": "\\.send_cancel\\(\\)"
                }
            ]
        },
        {
            "test_id": "cv_005",
            "name": "ISP logic violation",
            "tier": "ISP",
            "input": "def run(self):\n    self.socket = zmq.Context().socket(zmq.ROUTER)\n    while True:\n        msg = self.socket.recv()",
            "expected_violations": [
                {
                    "rule_id": "isp_stub_only",
                    "severity": "ERROR",
                    "pattern_matched": "while True:"
                }
            ]
        },
        {
            "test_id": "cv_006",
            "name": "ISP missing Numpy docstring",
            "tier": "ISP",
            "input": "def run(self):\n    # Main loop\n    pass",
            "expected_violations": [
                {
                    "rule_id": "isp_numpy_docstrings",
                    "severity": "ERROR",
                    "message": "Missing Numpy-style docstring with Implements section"
                }
            ]
        }
    ]
}
