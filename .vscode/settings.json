{
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".venv": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        ".venv": true
    },
    "editor.rulers": [
        80
    ],
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.formatOnSave": true
    },
    "[restructuredtext]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 80
    },
    // ## Antigravity ########################################################
    // # Prevent Antigravity from opening files in its proprietary form view #
    // #######################################################################
    //
    // 1. CRITICAL: Force the IDE to use the standard text editor ("default")
    // instead of the proprietary "Antigravity Form View" for these files.
    "workbench.editorAssociations": {
        "**/.agent/rules/**/*.md": "default",
        "**/.agent/tools/**/*.md": "default",
        "**/.agent/workflows/**/*.md": "default"
    },
    // 2. Ensure they are treated as standard Markdown for syntax highlighting
    // (Do NOT use 'antigravity-markdown' here, as that may re-trigger the GUI)
    "files.associations": {
        "**/.agent/**/*.md": "markdown"
    },
    "markdown.validate.enabled": true,
    "cSpell.words": [
        "abstractproperty",
        "agentic",
        "asdict",
        "autoflake",
        "classmethod",
        "cognitives",
        "contextlib",
        "contextmanager",
        "Cormen",
        "dataclass",
        "Dataclasses",
        "docstrings",
        "elif",
        "frontmatter",
        "funcs",
        "functools",
        "googleblog",
        "Halstead",
        "Hotspot",
        "hotspots",
        "inlinevar",
        "isinstance",
        "isort",
        "kernprof",
        "metaclass",
        "mypy",
        "Numpy",
        "opds",
        "optparse",
        "overgeneral",
        "pasteable",
        "pathlib",
        "promptbuilder",
        "pycodestyle",
        "pylint",
        "pytest",
        "sandboxed",
        "stdlib",
        "tkinter",
        "undoc",
        "zilliz"
    ],
    // =========================================================================
    // PowerShell: Hardened Agentic Execution Environment
    // =========================================================================
    // Enforce PowerShell 7 (pwsh) as the default integrated terminal.
    // Windows PowerShell 5.1 uses legacy encoding and is forbidden.
    "terminal.integrated.defaultProfile.windows": "PowerShell 7",
    "terminal.integrated.profiles.windows": {
        "PowerShell 7": {
            "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
            "args": [
                "-NoLogo"
            ]
        }
    },
    // =========================================================================
    // UTF-8: IDE Boundary Encoding Enforcement
    // =========================================================================
    // These variables are forcefully injected into every terminal session spawned
    // by the Antigravity IDE, preventing agentic subprocess hallucination failures.
    "terminal.integrated.env.windows": {
        // PEP 686 Standard: Forces Python 3.x to use UTF-8 globally for open(),
        // os.fsdecode(), and all standard streams.
        "PYTHONUTF8": "1",
        // Fallback safeguard for legacy Python tooling prior to UTF-8 Mode adoption.
        "PYTHONIOENCODING": "utf-8"
    },
    "markdown.validate.ignoredLinks": [
        "../assets/schemas/rule/rule.d.ts"
    ]
}
